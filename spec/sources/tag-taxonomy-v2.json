        {
          "id": "unit",
          "name": "ユニット・チーム",
          "cardinality": "0..n",
          "requiredWhen": "group_aliases_v2.jsonにあるグループとして活動している",
          "valueRule": "group_aliases_v2.jsonの正規名を使う。旧名・別名・ハッシュタグは検索別名として統合し、先頭の#は付けない"
        }
      ]
    },
