{
  "schemaVersion": "2.1.0",
  "name": "diopside tag taxonomy",
  "basis": {
    "metadataRecords": 1378,
    "legacyTaggedRecords": 1175,
    "legacyCoverage": 0.8527,
    "observedAt": "2026-07-10",
    "sources": [
      "output/*/*_metadata.json",
      "output/*/*.vtt",
      "output/*/*_comments.json",
      "output/*.json",
      "tags/tag_master.json",
      "tags/archive_index.p0.json"
    ]
  },
  "rules": {
    "required": [
      "content.primary",
      "format.media"
    ],
    "multipleTagsPerVideo": true,
    "multipleTagRule": "主ジャンルと動画形式は各1個。それ以外は該当するタグを複数付与できる",
    "conditionallyRequired": [
      {
        "field": "content.gameGenre",
        "when": "動画内でゲームをプレイしている"
      },
      {
        "field": "content.talkStyle",
        "when": "主ジャンルまたは副ジャンルが雑談"
      },
      {
        "field": "context.participation:コラボ",
        "when": "チャンネル主以外の出演者と共同で内容を行っている"
      },
      {
        "field": "people.performer",
        "when": "チャンネル主以外の出演者がいる"
      },
      {
        "field": "people.unit",
        "when": "既知グループとして活動している"
      }
    ],
    "derivedMetadata": [
      "people.channel",
      "entity relationships"
    ],
    "primaryContentCardinality": 1,
    "secondaryContentMaximum": 2,
    "recommendedMaximumExcludingPeople": 12,
    "unknownValue": null,
    "unclassifiedWorkflowState": "未分類・要レビュー",
    "unclassifiedRule": "判定不能な動画へ「その他」タグを保存せず、レビュー完了まで未分類状態にする",
    "entityModel": {
      "identityRule": "人物・グループ・チャンネル・ゲーム・イベント・シリーズ・楽曲・作品をIDで識別する",
      "roleRule": "動画との出演・言及・プレイ・視聴・歌唱・参加等の違いは関係種別として保持する",
      "compatibilityRule": "既存タグIDは検索URL互換のためlegacyTagIdsとして解決する",
      "listRule": "一覧は選択後に有用な動画集合へ到達できる分類値またはエンティティだけを公開する"
    }
  },
  "categories": [
