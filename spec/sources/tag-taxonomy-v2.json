      "name": "作品",
      "subcategories": [
        {
          "id": "gameTitle",
          "name": "ゲーム作品名",
          "cardinality": "1..n when applicable",
          "requiredWhen": "動画内でゲームをプレイしている",
          "valueRule": "公式の日本語タイトルを優先し、存在しなければ公式原題を使う。版・DLCが内容を区別する場合だけ残す"
        },
        {
          "id": "gameSeries",
          "name": "ゲームシリーズ名",
          "cardinality": "0..n",
          "valueRule": "シリーズを横断して探す需要があり、同一シリーズが2作品以上ある場合に付ける"
        },
        {
          "id": "watchedTitle",
          "name": "同時視聴作品名",
          "cardinality": "0..n",
          "valueRule": "映画・アニメ・ライブ等の公式作品名。話数はタグに含めない"
        },
        {
          "id": "trpgTitle",
          "name": "TRPGシステム・シナリオ名",
          "cardinality": "0..2",
          "valueRule": "システム名とシナリオ名を別タグとして保持する"
        },
        {
          "id": "songTitle",
          "name": "楽曲名",
          "cardinality": "0..n",
          "valueRule": "単曲動画または検索価値の高い代表曲だけ。通常の歌枠の全セットリストには付けない"
